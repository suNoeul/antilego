{"book":"Josh","chapter":15,"verses":[{"v":1,"text":"유다 자손의 지파가 그 가족대로 제비 뽑은 땅의 극남단은 에돔 지경에 이르고 또 남으로 신 광야까지라","mentions":[{"s":32,"e":34,"p":"a2735ff"}]},{"v":2,"text":"그 남편 경계는 염해의 극단 곧 남향한 해만에서부터"},{"v":3,"text":"아그랍빔 비탈 남편으로 지나 신에 이르고 가데스 바네아 남편으로 올라가서 헤스론을 지나며 아달로 올라가서 돌이켜 갈가에 이르고","mentions":[{"s":0,"e":4,"p":"a39267b"},{"s":23,"e":26,"p":"ac2cef0"},{"s":63,"e":66,"p":"a438f5e"}]},{"v":4,"text":"거기서 아스몬에 이르고 애굽 시내에 미치며 바다에 이르러 경계의 끝이 되나니 이것이 너희 남편 경계가 되리라","mentions":[{"s":4,"e":7,"p":"a8f6a28"}]},{"v":5,"text":"그 동편 경계는 염해니 요단 끝까지요 그 북편 경계는 요단 끝에 당한 해만에서부터","mentions":[{"s":13,"e":15,"p":"ae686c9"},{"s":30,"e":32,"p":"ae686c9"}]},{"v":6,"text":"벧호글라로 올라가서 벧 아라바 북편을 지나 르우벤 자손 보한의 돌에 이르고"},{"v":7,"text":"또 아골 골짜기에서부터 드빌을 지나 북으로 올라가서 강 남편에 있는 아둠밈 비탈 맞은편 길갈을 향하고 나아가 엔 세메스 물을 지나 엔로겔에 이르며","mentions":[{"s":2,"e":4,"p":"a31492f"},{"s":38,"e":41,"p":"a34e870"},{"s":49,"e":51,"p":"aed8df9"},{"s":73,"e":77,"p":"ad334c4"}]},{"v":8,"text":"또 힌놈의 아들의 골짜기로 올라가서 여부스 곧 예루살렘 남편 어깨에 이르며 또 힌놈의 골짜기 앞 서편에 있는 산 꼭대기로 올라가나니 이곳은 르바임 골짜기 북편 끝이며","mentions":[{"s":2,"e":4,"p":"a37c8e6"},{"s":26,"e":30,"p":"a15257a"},{"s":44,"e":46,"p":"a37c8e6"},{"s":78,"e":81,"p":"a7559e6"}]},{"v":9,"text":"또 이 산 꼭대기에서부터 넵도아 샘물까지 이르러 에브론산 성읍들에 미치고 또 바알라 곧 기럇 여아림에 미치며","mentions":[{"s":14,"e":17,"p":"a75aff4"},{"s":43,"e":46,"p":"ac2f5ea"}]},{"v":10,"text":"또 바알라에서부터 서편으로 돌이켜 세일산에 이르러 여아림산 곧 그살론 곁 북편에 이르고 또 벧 세메스로 내려가서 딤나로 지나고","mentions":[{"s":2,"e":5,"p":"a3587ba"},{"s":63,"e":65,"p":"a21f909"}]},{"v":11,"text":"또 에그론 북편으로 나아가 식그론에 이르러 바알라산에 미치고 얍느엘에 이르나니 그 끝은 바다며","mentions":[{"s":2,"e":5,"p":"a3fc47a"},{"s":24,"e":29,"p":"ac2b4ef"}]},{"v":12,"text":"서편 경계는 대해와 그 해변이니 유다 자손이 그 가족대로 얻은 사면 경계가 이러하니라"},{"v":13,"text":"여호와께서 여호수아에게 명하신대로 여호수아가 기럇 아르바 곧 헤브론 성을 유다 자손 중에서 분깃으로 여분네의 아들 갈렙에게 주었으니 아르바는 아낙의 아비였더라","mentions":[{"s":34,"e":37,"p":"a85151a"}]},{"v":14,"text":"갈렙이 거기서 아낙의 소생 곧 그 세 아들 세새와 아히만과 달매를 쫓아내었고"},{"v":15,"text":"거기서 올라가서 드빌 거민을 쳤는데 드빌의 본 이름은 기럇 세벨이라","mentions":[{"s":9,"e":11,"p":"ad2048e"},{"s":20,"e":22,"p":"ad2048e"}]},{"v":16,"text":"갈렙이 말하기를 기럇 세벨을 쳐서 그것을 취하는 자에게는 내가 내 딸 악사를 아내로 주리라 하였더니"},{"v":17,"text":"갈렙의 아우요 그나스의 아들인 옷니엘이 그것을 취함으로 갈렙이 그 딸 악사를 그에게 아내로 주었더라"},{"v":18,"text":"악사가 출가할 때에 그에게 청하여 자기 아비에게 밭을 구하자 하고 나귀에서 내리매 갈렙이 그에게 묻되 네가 무엇을 원하느냐"},{"v":19,"text":"가로되 내게 복을 주소서 아버지께서 나를 남방 땅으로 보내시오니 샘물도 내게 주소서 하매 갈렙이 윗샘과 아랫샘을 그에게 주었더라","mentions":[{"s":23,"e":25,"p":"a1cb244"},{"s":58,"e":62,"p":"a380434"}]},{"v":20,"text":"유다 자손의 지파가 그 가족대로 얻은 기업은 이러하니라"},{"v":21,"text":"유다 자손의 지파의 남으로 에돔 경계에 접근한 성읍들은 갑스엘과 에델과 야굴과","mentions":[{"s":15,"e":17,"p":"a2735ff"},{"s":31,"e":34,"p":"a1b30e1"}]},{"v":22,"text":"기나와 디모나와 아다다와","mentions":[{"s":9,"e":13,"p":"abf4481"}]},{"v":23,"text":"게데스와 하솔과 잇난과","mentions":[{"s":9,"e":12,"p":"a4fa255"}]},{"v":24,"text":"십과 델렘과 브알롯과","mentions":[{"s":7,"e":11,"p":"a14325e"}]},{"v":25,"text":"하솔 하닷다와 그리욧 헤스론 곧 하솔과","mentions":[{"s":3,"e":7,"p":"a4d3e40"}]},{"v":26,"text":"아맘과 세마와 몰라다와","mentions":[{"s":4,"e":7,"p":"a3e2b20"},{"s":8,"e":12,"p":"a03a5d0"}]},{"v":27,"text":"하살갓다와 헤스몬과 벧 벨렛과","mentions":[{"s":0,"e":5,"p":"a7672d8"}]},{"v":28,"text":"하살 수알과 브엘세바와 비스요댜와","mentions":[{"s":7,"e":11,"p":"a89005a"}]},{"v":29,"text":"바알라와 이임과 에셈과","mentions":[{"s":0,"e":3,"p":"a289254"},{"s":9,"e":12,"p":"a573b95"}]},{"v":30,"text":"엘돌랏과 그실과 홀마와","mentions":[{"s":0,"e":4,"p":"a5709da"},{"s":5,"e":8,"p":"acf2fac"}]},{"v":31,"text":"시글락과 맛만나와 산산나와 르바옷과","mentions":[{"s":0,"e":3,"p":"a0ed7ff"},{"s":5,"e":9,"p":"aeedde4"}]},{"v":32,"text":"실힘과 아인과 림몬이니 모두 이십 구 성읍이요 또 그 촌락이었으며","mentions":[{"s":4,"e":6,"p":"a8da370"},{"s":8,"e":10,"p":"a8fe47a"}]},{"v":33,"text":"평지에는 에스다올과 소라와 아스나와","mentions":[{"s":5,"e":9,"p":"a355b6e"},{"s":11,"e":13,"p":"a08174b"},{"s":15,"e":18,"p":"a1e3eff"}]},{"v":34,"text":"사노아와 엔간님과 답부아와 에남과","mentions":[{"s":0,"e":3,"p":"a28f432"},{"s":5,"e":9,"p":"a26921e"}]},{"v":35,"text":"야르뭇과 아둘람과 소고와 아세가와","mentions":[{"s":0,"e":3,"p":"a539e01"},{"s":5,"e":8,"p":"af82614"},{"s":10,"e":12,"p":"a39a6b9"},{"s":14,"e":17,"p":"af2ca0c"}]},{"v":36,"text":"사아라임과 아디다임과 그데라와 그데로다임이니 모두 십 사 성읍이요 또 그 촌락이었으며","mentions":[{"s":0,"e":4,"p":"a28da66"},{"s":6,"e":10,"p":"a845493"},{"s":17,"e":22,"p":"ac36af4"}]},{"v":37,"text":"스난과 하다사와 믹달갓과","mentions":[{"s":4,"e":8,"p":"a571ca0"}]},{"v":38,"text":"딜르안과 미스베와 욕드엘과","mentions":[{"s":0,"e":4,"p":"a45dd20"}]},{"v":39,"text":"라기스와 보스갓과 에글론과","mentions":[{"s":0,"e":3,"p":"a3cc590"},{"s":5,"e":8,"p":"a58252b"},{"s":10,"e":13,"p":"a244d8f"}]},{"v":40,"text":"갑본과 라맘과 기들리스와","mentions":[{"s":8,"e":13,"p":"a0ff819"}]},{"v":41,"text":"그데롯과 벧다곤과 나아마와 막게다니 모두 십 륙 성읍이요 또 그 촌락이었으며","mentions":[{"s":0,"e":4,"p":"a728f1b"},{"s":5,"e":9,"p":"a561af4"},{"s":15,"e":18,"p":"abf8e4e"}]},{"v":42,"text":"립나와 에델과 아산과","mentions":[{"s":0,"e":2,"p":"a97b595"},{"s":8,"e":10,"p":"a82f7b4"}]},{"v":43,"text":"입다와 아스나와 느십과","mentions":[{"s":4,"e":7,"p":"a9a57b7"},{"s":9,"e":12,"p":"a67bd13"}]},{"v":44,"text":"그일라와 악십과 마레사니 모두 아홉 성읍이요 또 그 촌락이었으며","mentions":[{"s":0,"e":3,"p":"ad9df93"},{"s":5,"e":7,"p":"a2270e4"},{"s":9,"e":12,"p":"a5cda86"}]},{"v":45,"text":"에그론과 그 향리와 촌락과","mentions":[{"s":0,"e":3,"p":"a3fc47a"}]},{"v":46,"text":"에그론에서부터 바다까지 아스돗 곁에 있는 모든 성읍과 그 촌락이었으며","mentions":[{"s":0,"e":3,"p":"a3fc47a"},{"s":13,"e":16,"p":"a30c937"}]},{"v":47,"text":"아스돗과 그 향리와 촌락과 가사와 그 향리와 촌락이니 애굽 시내와 대해 가에 이르기까지였으며","mentions":[{"s":0,"e":3,"p":"a30c937"},{"s":15,"e":17,"p":"aa8edd2"}]},{"v":48,"text":"산지는 사밀과 얏딜과 소고와","mentions":[{"s":4,"e":7,"p":"a846a2a"},{"s":8,"e":10,"p":"ad6eb0b"}]},{"v":49,"text":"단나와 기럇 산나 곧 드빌과","mentions":[{"s":0,"e":3,"p":"a65c305"},{"s":12,"e":14,"p":"ad2048e"}]},{"v":50,"text":"아납과 에스드모와 아님과","mentions":[{"s":0,"e":3,"p":"a234727"},{"s":4,"e":9,"p":"ac22b90"}]},{"v":51,"text":"고센과 홀론과 길로니 모두 십 일 성읍이요 또 그 촌락이었으며","mentions":[{"s":4,"e":7,"p":"a8819e0"}]},{"v":52,"text":"아랍과 두마와 에산과","mentions":[{"s":0,"e":2,"p":"a75d2ab"}]},{"v":53,"text":"야님과 벧 답부아와 아베가와","mentions":[{"s":11,"e":15,"p":"a175f4b"}]},{"v":54,"text":"훔다와 기럇 아르바 곧 헤브론과 시올이니 모두 아홉 성읍이요 또 그 촌락이었으며","mentions":[{"s":0,"e":2,"p":"a5a846f"},{"s":13,"e":16,"p":"a85151a"},{"s":18,"e":20,"p":"ac2907d"}]},{"v":55,"text":"마온과 갈멜과 십과 윳다와","mentions":[{"s":0,"e":2,"p":"a6845b1"},{"s":4,"e":6,"p":"a053f15"},{"s":11,"e":14,"p":"acc7184"}]},{"v":56,"text":"이스르엘과 욕드암과 사노아와","mentions":[{"s":6,"e":10,"p":"a56cad5"}]},{"v":57,"text":"가인과 기브아와 딤나니 모두 열 성읍이요 또 그 촌락이었으며","mentions":[{"s":9,"e":11,"p":"ae3f164"}]},{"v":58,"text":"할훌과 벧 술과 그돌과","mentions":[{"s":0,"e":2,"p":"afca9ce"},{"s":9,"e":11,"p":"af054ba"}]},{"v":59,"text":"마아랏과 벧 아놋과 엘드곤이니 모두 여섯 성읍이요 또 그 촌락이었으며","mentions":[{"s":0,"e":3,"p":"ae60c0c"},{"s":5,"e":9,"p":"aa2fea1"},{"s":11,"e":14,"p":"a26cd81"}]},{"v":60,"text":"기럇 바알 곧 기럇 여아림과 라빠니 모두 두 성읍이요 또 그 촌락이었으며","mentions":[{"s":11,"e":14,"p":"a28d652"}]},{"v":61,"text":"광야에는 벧 아라바와 밋딘과 스가가와","mentions":[{"s":16,"e":20,"p":"aec139c"}]},{"v":62,"text":"닙산과 염성과 엔 게디니 모두 여섯 성읍이요 또 그 촌락이었더라","mentions":[{"s":10,"e":13,"p":"acc1702"}]},{"v":63,"text":"예루살렘 거민 여부스 사람을 유다 자손이 쫓아내지 못하였으므로 여부스 사람이 오늘날까지 유다 자손과 함께 예루살렘에 거하니라","mentions":[{"s":0,"e":4,"p":"a15257a"},{"s":59,"e":63,"p":"a15257a"}]}],"places":[{"p":"a2735ff","n":2},{"p":"a39267b","n":1},{"p":"ac2cef0","n":1},{"p":"a438f5e","n":1},{"p":"a8f6a28","n":1},{"p":"ae686c9","n":2},{"p":"a31492f","n":1},{"p":"a34e870","n":1},{"p":"aed8df9","n":1},{"p":"ad334c4","n":1},{"p":"a37c8e6","n":2},{"p":"a15257a","n":3},{"p":"a7559e6","n":1},{"p":"a75aff4","n":1},{"p":"ac2f5ea","n":1},{"p":"a3587ba","n":1},{"p":"a21f909","n":1},{"p":"a3fc47a","n":3},{"p":"ac2b4ef","n":1},{"p":"a85151a","n":2},{"p":"ad2048e","n":3},{"p":"a1cb244","n":1},{"p":"a380434","n":1},{"p":"a1b30e1","n":1},{"p":"abf4481","n":1},{"p":"a4fa255","n":1},{"p":"a14325e","n":1},{"p":"a4d3e40","n":1},{"p":"a3e2b20","n":1},{"p":"a03a5d0","n":1},{"p":"a7672d8","n":1},{"p":"a89005a","n":1},{"p":"a289254","n":1},{"p":"a573b95","n":1},{"p":"a5709da","n":1},{"p":"acf2fac","n":1},{"p":"a0ed7ff","n":1},{"p":"aeedde4","n":1},{"p":"a8da370","n":1},{"p":"a8fe47a","n":1},{"p"