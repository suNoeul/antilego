{"book":"Josh","chapter":12,"verses":[{"v":1,"text":"이스라엘 자손이 요단 저편 해 돋는 편 곧 아르논 골짜기에서 헤르몬산까지의 동방 온 아라바를 점령하고 그 땅에서 쳐 죽인 왕들은 이러하니라","mentions":[{"s":9,"e":11,"p":"ae686c9"},{"s":24,"e":27,"p":"af4c2cd"},{"s":34,"e":37,"p":"a341fe8"},{"s":47,"e":50,"p":"a2bb5ef"}]},{"v":2,"text":"헤스본에 거하던 아모리 사람의 왕 시혼이라 그 다스리던 땅은 아르논 골짜기 가에 있는 아로엘에서부터 골짜기 가운데 성읍과 길르앗 절반 곧 암몬 자손의 지경 얍복강까지며","mentions":[{"s":0,"e":3,"p":"abf2fc1"},{"s":34,"e":37,"p":"af4c2cd"},{"s":48,"e":51,"p":"ae46f2e"},{"s":68,"e":71,"p":"ae73b90"},{"s":77,"e":79,"p":"a6046fa"},{"s":87,"e":89,"p":"aca7bd9"}]},{"v":3,"text":"또 동방 아라바 긴네롯 바다까지며 또 동방 아라바의 바다 곧 염해의 벧여시못으로 통한 길까지와 남편으로 비스가 산록까지며","mentions":[{"s":5,"e":8,"p":"a2bb5ef"},{"s":24,"e":27,"p":"a2bb5ef"},{"s":38,"e":42,"p":"a30f37b"},{"s":58,"e":61,"p":"afd9259"}]},{"v":4,"text":"또 르바의 남은 족속으로서 아스다롯과 에드레이에 거하던 바산 왕 옥이라","mentions":[{"s":15,"e":19,"p":"a6fea11"},{"s":21,"e":25,"p":"aaa6f7a"},{"s":31,"e":33,"p":"aa7a40a"}]},{"v":5,"text":"그 치리하던 땅은 헤르몬산과 살르가와 온 바산과 및 그술 사람과 마아가 사람의 지경까지의 길르앗 절반이니 헤스본 왕 시혼의 지경에 접한 것이라","mentions":[{"s":10,"e":13,"p":"a341fe8"},{"s":16,"e":19,"p":"ac3bc41"},{"s":23,"e":25,"p":"aa7a40a"},{"s":29,"e":31,"p":"af6c325"},{"s":50,"e":53,"p":"ae73b90"},{"s":59,"e":62,"p":"abf2fc1"}]},{"v":6,"text":"여호와의 종 모세와 이스라엘 자손이 그들을 치고 여호와의 종 모세가 그 땅을 르우벤 사람과 갓 사람과 므낫세 반 지파에게 기업으로 주었더라"},{"v":7,"text":"여호수아와 이스라엘 자손이 요단 이편 곧 서편 레바논 골짜기의 바알갓에서부터 세일로 올라가는 곳 할락산까지에서 쳐서 멸한 왕들은 이러하니 (그 땅을 여호수아가 이스라엘의 구별을 따라 그 지파에게 기업으로 주었으니","mentions":[{"s":15,"e":17,"p":"ae686c9"},{"s":43,"e":45,"p":"ae981db"},{"s":54,"e":57,"p":"a11fadd"}]},{"v":8,"text":"곧 산지와 평지와 아라바와 경사지와 광야와 남방 곧 헷 사람과 아모리 사람과 가나안 사람과 브리스 사람과 히위 사람과 여부스 사람의 땅이라)","mentions":[{"s":10,"e":13,"p":"a2bb5ef"},{"s":24,"e":26,"p":"a1cb244"}]},{"v":9,"text":"하나는 여리고 왕이요 하나는 벧엘 곁의 아이 왕이요","mentions":[{"s":4,"e":7,"p":"a231f80"},{"s":16,"e":18,"p":"a64f355"},{"s":22,"e":24,"p":"a7e13e1"}]},{"v":10,"text":"하나는 예루살렘 왕이요 하나는 헤브론 왕이요 하나는 야르뭇 왕이요","mentions":[{"s":4,"e":8,"p":"a15257a"},{"s":17,"e":20,"p":"a85151a"}]},{"v":11,"text":"하나는 라기스 왕이요","mentions":[{"s":4,"e":7,"p":"a3cc590"}]},{"v":12,"text":"하나는 에글론 왕이요 하나는 게셀 왕이요","mentions":[{"s":4,"e":7,"p":"a244d8f"},{"s":16,"e":18,"p":"aed6538"}]},{"v":13,"text":"하나는 드빌 왕이요 하나는 게델 왕이요","mentions":[{"s":4,"e":6,"p":"ad2048e"},{"s":15,"e":17,"p":"a55d681"}]},{"v":14,"text":"하나는 호르마 왕이요 하나는 아랏 왕이요","mentions":[{"s":4,"e":7,"p":"ada25df"},{"s":16,"e":18,"p":"abc358b"}]},{"v":15,"text":"하나는 립나 왕이요 하나는 아둘람 왕이요","mentions":[{"s":4,"e":6,"p":"a97b595"},{"s":15,"e":18,"p":"af82614"}]},{"v":16,"text":"하나는 막게다 왕이요 하나는 벧엘 왕이요","mentions":[{"s":4,"e":7,"p":"abf8e4e"},{"s":16,"e":18,"p":"a64f355"}]},{"v":17,"text":"하나는 답부아 왕이요 하나는 헤벨 왕이요","mentions":[{"s":4,"e":7,"p":"a03be2e"}]},{"v":18,"text":"하나는 아벡 왕이요 하나는 랏사론 왕이요","mentions":[{"s":4,"e":6,"p":"a7b2e63"},{"s":15,"e":18,"p":"a8bbf2b"}]},{"v":19,"text":"하나는 마돈 왕이요 하나는 하솔 왕이요","mentions":[{"s":4,"e":6,"p":"a6c2936"},{"s":15,"e":17,"p":"a6f33c5"}]},{"v":20,"text":"하나는 시므론 므론 왕이요 하나는 악삽 왕이요","mentions":[{"s":4,"e":7,"p":"ae20466"},{"s":19,"e":21,"p":"a8ce5c4"}]},{"v":21,"text":"하나는 다아낙 왕이요 하나는 므깃도 왕이요","mentions":[{"s":4,"e":7,"p":"a6f05f6"},{"s":16,"e":19,"p":"a8554e3"}]},{"v":22,"text":"하나는 게데스 왕이요 하나는 갈멜의 욕느암 왕이요","mentions":[{"s":4,"e":7,"p":"a321cb8"},{"s":16,"e":18,"p":"a3e21c6"},{"s":20,"e":23,"p":"a5c92e1"}]},{"v":23,"text":"하나는 돌의 높은 곳의 돌 왕이요 하나는 길갈의 고임 왕이요","mentions":[{"s":4,"e":6,"p":"ad05040"},{"s":27,"e":29,"p":"a3cefc6"}]},{"v":24,"text":"하나는 디르사 왕이라 도합 삼십 일 왕이었더라","mentions":[{"s":4,"e":7,"p":"a80d317"}]}],"places":[{"p":"ae686c9","n":2},{"p":"af4c2cd","n":2},{"p":"a341fe8","n":2},{"p":"a2bb5ef","n":4},{"p":"abf2fc1","n":2},{"p":"ae46f2e","n":1},{"p":"ae73b90","n":2},{"p":"a6046fa","n":1},{"p":"aca7bd9","n":1},{"p":"a30f37b","n":1},{"p":"afd9259","n":1},{"p":"a6fea11","n":1},{"p":"aaa6f7a","n":1},{"p":"aa7a40a","n":2},{"p":"ac3bc41","n":1},{"p":"af6c325","n":1},{"p":"ae981db","n":1},{"p":"a11fadd","n":1},{"p":"a1cb244","n":1},{"p":"a231f80","n":1},{"p":"a64f355","n":2},