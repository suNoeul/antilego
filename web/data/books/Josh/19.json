{"book":"Josh","chapter":19,"verses":[{"v":1,"text":"둘째로 시므온 곧 시므온 자손의 지파를 위하여 그 가족대로 제비를 뽑았으니 그 기업은 유다 자손의 기업 중에서라"},{"v":2,"text":"그 얻은 기업은 브엘세바 곧 세바와 몰라다와","mentions":[{"s":9,"e":13,"p":"ad2f6c2"},{"s":20,"e":24,"p":"a03a5d0"}]},{"v":3,"text":"하살 수알과 발라와 에셈과","mentions":[{"s":7,"e":9,"p":"a8ac29f"},{"s":11,"e":14,"p":"a573b95"}]},{"v":4,"text":"엘돌랏과 브둘과 호르마와","mentions":[{"s":0,"e":4,"p":"a5709da"},{"s":5,"e":8,"p":"a92de65"},{"s":9,"e":12,"p":"ada25df"}]},{"v":5,"text":"시글락과 벧 말가봇과 하살수사와","mentions":[{"s":0,"e":4,"p":"a87f8f5"},{"s":12,"e":16,"p":"ab270f6"}]},{"v":6,"text":"벧 르바옷과 사루헨이니 십 삼 성읍이요 또 그 촌락이며","mentions":[{"s":0,"e":5,"p":"a289a5b"},{"s":7,"e":10,"p":"a887d36"}]},{"v":7,"text":"또 아인과 림몬과 에델과 아산이니 네 성읍이요 또 그 촌락이며","mentions":[{"s":2,"e":4,"p":"a8da370"},{"s":14,"e":16,"p":"a16596e"}]},{"v":8,"text":"또 남방 라마 곧 바알랏 브엘까지 이 성들을 둘러 있는 모든 촌락이니 이는 시므온 자손의 지파가 그 가족대로 얻은 기업이라","mentions":[{"s":2,"e":4,"p":"a1cb244"},{"s":5,"e":7,"p":"aaa4c6e"}]},{"v":9,"text":"시므온 자손의 이 기업은 유다 자손의 기업 중에서 취하였으니 이는 유다 자손의 분깃이 자기들에게 너무 많으므로 시므온 자손이 자기의 기업을 그들의 기업 중에서 얻음이었더라"},{"v":10,"text":"세째로 스불론 자손을 위하여 그 가족대로 제비를 뽑았으니 그 기업의 경계는 사릿에 미치고","mentions":[{"s":42,"e":45,"p":"ab5b542"}]},{"v":11,"text":"서편으로 올라가서 마랄라에 이르러 답베셋에 미치고 욕느암 앞 시내에 미치며","mentions":[{"s":19,"e":23,"p":"a411151"},{"s":28,"e":31,"p":"a5c92e1"}]},{"v":12,"text":"사릿에서부터 동편으로 돌아 해 뜨는 편을 향하고 기슬롯 다볼의 경계에 이르고 다브랏으로 나가서 야비아로 올라가고","mentions":[{"s":0,"e":2,"p":"ab5b542"},{"s":27,"e":33,"p":"a898f06"},{"s":43,"e":46,"p":"a6a5e97"},{"s":53,"e":56,"p":"ab15bb3"}]},{"v":13,"text":"또 거기서부터 동편으로 가드 헤벨을 지나 엣 가신에 이르고 네아까지 연한 림몬으로 나아가서","mentions":[{"s":23,"e":27,"p":"a2ca712"},{"s":41,"e":43,"p":"a813f22"}]},{"v":14,"text":"북으로 돌아 한나돈에 이르고 입다엘 골짜기에 이르러 끝이 되며","mentions":[{"s":7,"e":11,"p":"a412c43"}]},{"v":15,"text":"또 갓닷과 나할랄과 시므론과 이달라와 베들레헴이니 모두 십 이 성읍이요 또 그 촌락이라","mentions":[{"s":6,"e":9,"p":"ac69561"},{"s":11,"e":14,"p":"a072bae"},{"s":21,"e":25,"p":"a308715"}]},{"v":16,"text":"스불론 자손이 그 가족대로 얻은 기업은 이 성읍들과 그 촌락이었더라"},{"v":17,"text":"네째로 잇사갈 곧 잇사갈 자손을 위하여 그 가족대로 제비를 뽑았으니"},{"v":18,"text":"그 지경 안은 이스르엘과 그술롯과 수넴과","mentions":[{"s":8,"e":12,"p":"ae0bf4a"},{"s":14,"e":18,"p":"ac3d92d"},{"s":19,"e":21,"p":"ac86af5"}]},{"v":19,"text":"하바라임과 시온과 아나하랏과","mentions":[{"s":0,"e":5,"p":"a03f6cf"}]},{"v":20,"text":"랍빗과 기시온과 에베스와","mentions":[{"s":9,"e":13,"p":"a13ffd4"}]},{"v":21,"text":"레멧과 언간님과 엔핫다와 벧 바세스며","mentions":[{"s":9,"e":13,"p":"a009e7d"}]},{"v":22,"text":"그 경계는 다볼과 사하수마와 벧 세메스에 미치고 그 끝은 요단이니 모두 십 륙 성읍이요 또 그 촌락이라","mentions":[{"s":6,"e":8,"p":"acd63ee"},{"s":10,"e":15,"p":"a3bb26d"},{"s":32,"e":34,"p":"ae686c9"}]},{"v":23,"text":"잇사갈 자손 지파가 그 가족대로 얻은 기업은 이 성읍들과 그 촌락이었더라"},{"v":24,"text":"다섯째로 아셀 자손의 지파를 위하여 그 가족대로 제비를 뽑았으니"},{"v":25,"text":"그 지경 안은 헬갓과 할리와 베덴과 악삽과","mentions":[{"s":8,"e":10,"p":"a1d1918"},{"s":12,"e":15,"p":"a79d6a5"},{"s":20,"e":22,"p":"a8ce5c4"}]},{"v":26,"text":"알람멜렉과 아맛과 미살이며 그 경계의 서편은 갈멜에 미치며 시홀 림낫에 미치고","mentions":[{"s":0,"e":4,"p":"a84cafa"},{"s":6,"e":8,"p":"a2f1fa1"},{"s":10,"e":12,"p":"a93f8b6"},{"s":25,"e":27,"p":"a3e21c6"},{"s":33,"e":38,"p":"ac6b338"}]},{"v":27,"text":"꺾여 해 돋는 편을 향하여 벧 다곤에 이르며 스불론에 달하고 북편으로 입다 엘 골짜기에 미쳐서 벧에멕과 느이엘에 이르고 가불 좌편으로 나가서","mentions":[{"s":15,"e":19,"p":"a0cc925"},{"s":53,"e":56,"p":"a587ea0"},{"s":58,"e":61,"p":"ab571de"},{"s":67,"e":69,"p":"a978a24"}]},{"v":28,"text":"에브론과 르홉과 함몬과 가나를 지나 큰 시돈까지 이르고","mentions":[{"s":13,"e":15,"p":"a728e07"},{"s":22,"e":24,"p":"a98e4d7"}]},{"v":29,"text":"돌아서 라마와 견고한 성읍 두로에 이르고 돌아서 호사에 이르고 악십 지방 곁 바다가 끝이 되며","mentions":[{"s":15,"e":17,"p":"a160272"},{"s":27,"e":30,"p":"a2feddf"},{"s":35,"e":37,"p":"ad0d82f"}]},{"v":30,"text":"또 움마와 아벡과 르홉이니 모두 이십 이 성읍과 그 촌락이라","mentions":[{"s":10,"e":12,"p":"ab71288"}]},{"v":31,"text":"아셀 자손의 지파가 그 가족대로 얻은 기업은 이 성읍들과 그 촌락이었더라"},{"v":32,"text":"여섯째로 납달리 자손을 위하여 납달리 자손의 가족대로 제비를 뽑았으니"},{"v":33,"text":"그 경계는 헬렙과 사아난님의 상수리나무에서부터 아다미 네겝과 얍느엘을 지나 락굼까지요 그 끝은 요단이며","mentions":[{"s":6,"e":8,"p":"a8687ff"},{"s":10,"e":14,"p":"a0c4f5e"},{"s":26,"e":32,"p":"a2c780b"},{"s":34,"e":37,"p":"abff89f"},{"s":42,"e":44,"p":"abe5dde"},{"s":53,"e":55,"p":"ae686c9"}]},{"v":34,"text":"서편으로 돌아 아스놋 다볼에 이르고 그곳에서부터 나가 훅곡에 이르러는 남은 스불론에 접하였고 서는 아셀에 접하였으며 해 돋는 편은 유다에 달한 요단이며","mentions":[{"s":20,"e":22,"p":"a901903"},{"s":80,"e":82,"p":"ae686c9"}]},{"v":35,"text":"그 견고한 성읍들은 싯딤과 세르와 함맛과 락갓과 긴네렛과","mentions":[{"s":27,"e":30,"p":"a061538"}]},{"v":36,"text":"아다마와 라마와 하솔과","mentions":[{"s":0,"e":4,"p":"a010244"},{"s":9,"e":11,"p":"a6f33c5"}]},{"v":37,"text":"게데스와 에드레이와 엔 하솔과","mentions":[{"s":0,"e":3,"p":"a662eed"},{"s":5,"e":10,"p":"a156070"}]},{"v":38,"text":"이론과 믹다렐과 호렘과 벧 아낫과 벧 세메스니 모두 십 구 성읍이요 또 그 촌락이라","mentions":[{"s":21,"e":25,"p":"a5f0bc3"}]},{"v":39,"text":"납달리 자손의 지파가 그 가족대로 얻은 기업은 이 성읍들과 그 촌락이었더라"},{"v":40,"text":"일곱째로 단 자손의 지파를 위하여 그 가족대로 제비를 뽑았으니"},{"v":41,"text":"그 기업의 지경은 소라와 에스다올과 이르세메스와","mentions":[{"s":10,"e":12,"p":"a08174b"},{"s":14,"e":18,"p":"a355b6e"}]},{"v":42,"text":"사알랍빈과 아얄론과 이들라와","mentions":[{"s":0,"e":5,"p":"abf8060"},{"s":6,"e":9,"p":"a1c600b"}]},{"v":43,"text":"엘론과 딤나와 에그론과","mentions":[{"s":0,"e":2,"p":"ae180d8"},{"s":4,"e":6,"p":"a21f909"},{"s":8,"e":11,"p":"a3fc47a"}]},{"v":44,"text":"엘드게와 깁브돈과 바알랏과","mentions":[{"s":5,"e":9,"p":"a3c4559"}]},{"v":45,"text":"여훗과 브네브락과 가드 림몬과","mentions":[{"s":4,"e":9,"p":"aa0ef78"}]},{"v":46,"text":"메얄곤과 락곤과 욥바 맞은편 경계까지라","mentions":[{"s":0,"e":3,"p":"a7d1972"},{"s":5,"e":7,"p":"aa3e5ae"},{"s":9,"e":11,"p":"ae023a9"}]},{"v":47,"text":"그런데 단 자손의 지경이 더욱 확장되었으니 이는 단 자손이 올라가서 레센을 쳐서 취하여 칼날로 치고 그것을 얻어 거기 거하였음이라 그 조상 단의 이름을 따라서 레센을 단이라 하였더라","mentions":[{"s":4,"e":5,"p":"a513646"},{"s":27,"e":28,"p":"a513646"},{"s":78,"e":79,"p":"a513646"},{"s":93,"e":94,"p":"a513646"}]},{"v":48,"text":"단 자손의 지파가 그 가족대로 얻은 기업은 이 성읍들과 그 촌락이었더라"},{"v":49,"text":"이스라엘 자손이 그 경계를 따라서 기업의 땅 나누기를 마치고 자기들 중에서 눈의 아들 여호수아에게 기업을 주었으되"},{"v":50,"text":"곧 여호와의 명령대로 여호수아의 구한 성읍 에브라임 산지 딤낫 세라를 주매 여호수아가 그 성읍을 중건하고 거기 거하였었더라","mentions":[{"s":32,"e":34,"p":"a6e6528"}]},{"v":51,"text":"제사장 엘르아살과 눈의 아들 여호수아와 이스라엘 자손 지파의 족장들이 실로에서 회막 문 여호와 앞에서 제비 뽑아 나눈 기업이 이러하니라 이에 땅 나누는 일이 마쳤더라","mentions":[{"s":39,"e":41,"p":"aa4680a"}]}],"places":[{"p":"ad2f6c2","n":1},{"p":"a03a5d0","n":1},{"p":"a8ac29f","n":1},{"p":"a573b95","n":1},{"p":"a5709da","n":1},{"p":"a92de65","n":1},{"p":"ada25df","n":1},{"p":"a87f8f5","n":1},{"p":"ab270f6","n":1},{"p":"a289a5b","n":1},{"p":"a887d36","n":1},{"p":"a8da370","n":1},{"p":"a16596e","n":1},{"p":"a1cb244","n":1},{"p":"aaa4c6e","n":1},{"p":"ab5b542","n":2},{"p":"a411151","n":1},{"p":"a5c92e1","n":1},{"p":"a898f06","n":1},{"p":"a6a5e97","n":1},{"p":"ab15bb3","n":1},{"p":"a2ca712","n":1},{"p":"a813f22","n":1},{"p":"a412c43","n":1},{"p":"ac69561","n":1},{"p":"a072bae","n":1},{"p":"a308715","n":1},{"p":"ae0bf4a","n":1},{"p":"ac3d92d","n":1},{"p":"ac86af5","n":1},{"p":"a03f6cf","n":1},{"p":"a13ffd4","n":1},{"p":"a009e7d","n":1},{"p":"acd63ee","n":1},{"p":"a3bb26d","n":1},{"p":"ae686c9","n":3},{"p":"a1d1918","n":1},{"p":"a79d6a5","n":1},{"p":"a8ce5c4","n":1},{"p":"a84cafa","n":1},{"p":"a2f1fa1","n":1},{"p":"a93f8b6","n":1},{"p":"a3e21c6","n":1},{"p":"ac6b338","n":1},{"p":"a0cc925","n":1},{"p":"a587ea0","n":1},{"p":"ab571de","n":1},{"p":"a978a24","n":1},{"p":"a728e07","n":1},{"p":"a98e4d7","n":1},{"p":"a160272","n":1},{"p":"a2feddf","n":1},{"p":"ad0d82f","n":1},{"p":"ab71288","n":1},{"p":"a8687ff","n":1},{"p":"a0c4f5e","n":1},{"p":"a2c780b","n":1},{"p":"abff89f","n":1},{"p":"abe5dde","n":1},{"p":"a901903","n":1},{"p":"a061538","n":1},{"p":"a010244","n":1},{"p":"a6f33c5","n":1},{"p":"a662eed","n":1},{"p":"a156070","n":1},{"p":"a5f0bc3","n":1},{"p":"a08174b","n":1},{"p":"a355b6e","n":1},{"p":"abf8060","n":1},{"p":"a1c600b","n":1},{"p":"ae180d8","n":1},{"p":"a21f909","n":1},{"p":"a3fc47a","n":1},{"p":"a3c4559","n":1},{"p":"aa0ef78","n":1},{"p":"a7d1972","n":1},{"p":"aa3e5ae","n":1},{"p":"ae023a9","n":1},{"p":"a513646","n":4},{"p":"a6e6528","n":1},{"p":"aa4680a","n":1}]}